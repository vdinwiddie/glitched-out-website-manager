<UserControl x:Class="glitched_out_website_manager.Views.Shows.AddShowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shows="clr-namespace:glitched_out_website_manager.Views.Shows"
        mc:Ignorable="d">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Date -->
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,5"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Text="Date" />

        <DatePicker Grid.Row="1"
                    SelectedDate="{Binding ShowDate}"
                    Width="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>

        <!-- Venue -->
        <TextBlock Grid.Row="2"
                   Margin="0,0,0,5"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Text="Venue" />

        <TextBox Grid.Row="3"
                 Text="{Binding Venue}"
                 VerticalAlignment="Top" />
        
        <!-- Location -->
        <TextBlock Grid.Row="4"
                   Margin="0,0,0,5"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Text="Location" />

        <TextBox Grid.Row="5"
                 Text="{Binding Location}"
                 VerticalAlignment="Top" />

        <!-- Tickets -->
        <TextBlock Grid.Row="6"
                   Margin="0,0,0,5"
                   FontSize="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Text="Ticket Link" />

        <TextBox Grid.Row="7"
                 Text="{Binding Location}"
                 VerticalAlignment="Top" />

        <!-- Save Button -->
        <Button Grid.Row="8"
                Content="Confirm"
                Command="{Binding AddShowCommand}"
                Width="100"
                Height="25"
                HorizontalAlignment="Center"
                Margin="0,10" />
    </Grid>
</UserControl>
